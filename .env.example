DATABASE_POOL_URL="postgresql://neondb_owner:<Password>@ep-lingering-thunder-ate1tkym-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DB_POOL_MAX=10
GROQ_API_KEY=gsk_your_actual_api_key_here
GITHUB_APP_ID="your_app_id"
GITHUB_WEBHOOK_SECRET="your_webhook_secret"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_URL=https://github.com/apps/
GITHUB_CLIENT_ID="your_oauth_app_client_id"
GITHUB_CLIENT_SECRET="your_oauth_app_client_secret"
AUTH_SECRET="your_random_secret_here"
AUTH_URL=http://localhost:9002
ARMORIQ_API_KEY=
USER_ID=
AGENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:9002
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Number of trusted proxies in front of the app. Used to pick the real client IP
# out of X-Forwarded-For when bucketing rate limits: 1 for Vercel/Render/a single
# nginx, 2 behind Cloudflare as well, 0 when the app is exposed directly (which
# makes the forwarding headers untrusted entirely). Defaults to 1 when unset.
TRUSTED_PROXY_HOP_COUNT=1
# Optional alternative to the hop count — a comma-separated allowlist of proxy
# addresses / IPv4 CIDRs, e.g. 10.0.0.0/8,192.168.1.1
TRUSTED_PROXY_IPS=
GROQ_MODEL=openai/gpt-oss-20b
