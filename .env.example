# ==========================================
# Database Configuration (PostgreSQL / Neon)
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/secureflow?sslmode=disable"
DATABASE_POOL_URL="postgresql://user:password@localhost:5432/secureflow?sslmode=disable&pgbouncer=true"
DB_POOL_MAX=10

# ==========================================
# Application Configuration
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:9002
LOG_LEVEL=info
TRUSTED_PROXY_HOP_COUNT=1
TRUSTED_PROXY_IPS=

# ==========================================
# Authentication (Auth.js)
# ==========================================
AUTH_SECRET="your_random_secret_here"
AUTH_URL=http://localhost:9002

# ==========================================
# GitHub App & OAuth Integration
# ==========================================
GITHUB_APP_ID="your_app_id"
GITHUB_WEBHOOK_SECRET="your_webhook_secret"
GITHUB_WEBHOOK_MAX_BYTES=5242880
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_URL=https://github.com/apps/your-app-name
GITHUB_CLIENT_ID="your_oauth_app_client_id"
GITHUB_CLIENT_SECRET="your_oauth_app_client_secret"

# ==========================================
# Redis / Upstash Cache
# ==========================================
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# External APIs (Groq, Armoriq)
# ==========================================
GROQ_API_KEY=gsk_your_actual_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
ARMORIQ_API_KEY=
USER_ID=
AGENT_ID=

# ==========================================
# Data Retention Policies (Days)
# ==========================================
FINDING_SNIPPET_REDACT_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=30
SCAN_RESULT_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365

# ==========================================
# Outbound Webhook Security
# ==========================================
OUTBOUND_WEBHOOK_TIMEOUT_MS=10000
OUTBOUND_WEBHOOK_MAX_RESPONSE_BYTES=65536
OUTBOUND_WEBHOOK_ALLOWED_HOSTS=
OUTBOUND_WEBHOOK_ALLOW_INSECURE_HTTP=false
OUTBOUND_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# ==========================================
# Content Security Policy (CSP)
# ==========================================
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
