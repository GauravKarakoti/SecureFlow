{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopedServicePermissions",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::my-production-bucket/*"
    },
    {
      "Sid": "ScopedWildcardResourceOnly",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
