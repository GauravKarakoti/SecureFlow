{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopedServiceAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::my-production-bucket/*"
    },
    {
      "Sid": "WildcardActionOnSpecificResource",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::my-production-bucket/*"
    },
    {
      "Sid": "ExplicitDenyAll",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*"
    }
  ]
}
