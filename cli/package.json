{
  "name": "secureflow-cli",
  "version": "3.1.0",
  "description": "Pre-commit secret logging detector for secure development workflows",
  "main": "./dist/index.js",
  "bin": {
    "secureflow": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "publish": "npm publish",
    "test": "vitest run",
    "test:e2e": "vitest run src/e2e.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "security",
    "secrets",
    "scanner",
    "pre-commit",
    "husky",
    "secureflow"
  ],
  "author": "Gaurav Karakoti",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6",
    "vitest": "^5.1.0"
  }
}
