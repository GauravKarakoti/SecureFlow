{
  "name": "secureflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "dev": "concurrently \"next dev --turbopack -p 9002\" \"tsx scripts/prewarm.ts\"",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:redteam": "vitest run src/ai/flows/heist-prompt-guard.redteam.test.ts",
    "threat-feed:sync": "tsx scripts/sync-threat-feed.ts",
    "threat-feed:sync:render": "tsx --env-file=.env scripts/sync-threat-feed.ts",
    "test:e2e": "playwright test",
    "cli:build": "npm run build --workspace=cli",
    "cli:test": "npm run test --workspace=cli",
    "cli:test:e2e": "npm run test:e2e --workspace=cli",
    "cli:typecheck": "tsc --noEmit --project cli/tsconfig.json",
    "db:gen": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "postinstall": "prisma generate",
    "worker": "tsx --env-file=.env scripts/start-worker.ts",
    "worker:render": "tsx scripts/start-worker.ts",
    "retention": "tsx --env-file=.env scripts/retention.ts",
    "retention:render": "tsx scripts/retention.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check . || node -e \"console.error('\\n❌ Formatting check failed! Run: npm run format\\n'); process.exit(1)\"",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky",
    "ngrok": "ngrok http 9002",
    "secureflow": "npx secureflow",
    "verify:openapi": "tsx scripts/verify-openapi.ts"
  },
  "dependencies": {
    "@armoriq/sdk": "^0.8.23",
    "@auth/prisma-adapter": "^2.11.3",
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@genkit-ai/compat-oai": "^1.43.0",
    "@hookform/resolvers": "^6.0.0",
    "@octokit/plugin-throttling": "^11.0.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bullmq": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "genkit": "^1.39.0",
    "genkitx-groq": "^0.31.0",
    "groq-sdk": "^1.6.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-countup": "^6.5.3",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "swagger-ui-react": "^5.34.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-countup": "^4.3.1",
    "@types/react-dom": "^19.2.7",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "genkit-cli": "^1.44.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "secureflow-cli": "^2.5.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
