{
  "name": "secureflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "dev": "concurrently \"next dev --turbopack -p 9002\" \"tsx scripts/prewarm.ts\"",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:redteam": "vitest run src/ai/flows",
    "test:e2e": "playwright test",
    "cli:build": "npm run build --workspace=cli",
    "cli:test": "npm run test --workspace=cli",
    "cli:typecheck": "tsc --noEmit --project cli/tsconfig.json",
    "db:gen": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "postinstall": "prisma generate",
    "worker": "tsx --env-file=.env scripts/start-worker.ts",
    "worker:render": "tsx scripts/start-worker.ts",
    "retention": "tsx --env-file=.env scripts/retention.ts",
    "retention:render": "tsx scripts/retention.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "prepare": "husky",
    "ngrok": "ngrok http 9002",
    "secureflow": "npx secureflow"
  },
  "dependencies": {
    "@armoriq/sdk": "^0.6.10",
    "@auth/prisma-adapter": "^2.11.3",
    "@genkit-ai/compat-oai": "^1.41.0",
    "@hookform/resolvers": "^5.9.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "bullmq": "^6.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "genkit": "^1.39.0",
    "genkitx-groq": "^0.31.0",
    "groq-sdk": "^1.6.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "octokit": "^5.0.5",
    "patch-package": "^8.0.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-countup": "^6.5.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-countup": "^4.3.1",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "genkit-cli": "^1.42.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "secureflow-cli": "^1.2.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
